# Postgres. Local: `npm run db:server` (PGlite). Production: Neon pooled connection string.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional GitHub sign-in. Leave blank to offer email + password only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Catalog seed source: the ScentLens export (never committed to this repo).
SCENTLENS_PRODUCTS_CSV=../scent-lens/artifacts/export/products.csv

# Scanner. Off unless SCANNER_MODE=live and SCENTLENS_URL is set.
# "mock" returns fixed test data and only works outside production.
SCANNER_MODE=
SCENTLENS_URL=https://bhnsadhu--accord-scanner-web.us-east.modal.run/
SCAN_GLOBAL_DAILY=3
SCAN_GLOBAL_MONTHLY=60
SCAN_USER_DAILY=2
SCAN_GUEST_DAILY=1

# Production uses the private endpoint in deploy/scanner.py.
SCENTLENS_PROTOCOL=private
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

# Free transactional email. Enable only after the scoped sending key is configured.
AUTH_EMAIL_ENABLED=false
AUTH_EMAIL_FROM="Accord <accounts@bhanusadhu.com>"
RESEND_API_KEY=

# Protected database health check. Store the same secret in the monitor workflow.
MONITOR_SECRET=
