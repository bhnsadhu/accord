# Postgres. Local: `npm run db:server` (PGlite). Production: Neon pooled connection string.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional GitHub sign-in. Leave blank to offer email + password only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Catalog seed source: the ScentLens export (never committed to this repo).
SCENTLENS_PRODUCTS_CSV=../scent-lens/artifacts/export/products.csv

# Scanner. Off unless SCANNER_MODE=live and SCENTLENS_URL is set.
# "mock" returns fixed test data and only works outside production.
SCANNER_MODE=
SCENTLENS_URL=https://bhnsadhu--scent-lens-web.us-east.modal.run/
SCAN_GLOBAL_DAILY=3
SCAN_USER_DAILY=2
SCAN_GUEST_DAILY=1
